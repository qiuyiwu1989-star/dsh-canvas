{
  "name": "dsh-canvas",
  "version": "0.1.0",
  "description": "Thinking Canvas for DeepSeek Harness: turn a live session into a pan-and-zoom canvas of intents, AI contributions, tool actions and results — with sourced quotes you can trace back",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "author": {
    "name": "qiuyiwu",
    "url": "https://github.com/qiuyiwu1989-star"
  },
  "homepage": "https://github.com/qiuyiwu1989-star/dsh-canvas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiuyiwu1989-star/dsh-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/qiuyiwu1989-star/dsh-canvas/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "canvas",
    "thinking-canvas",
    "visualization",
    "conversation-view"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "example": "node scripts/smoke.mjs --write",
    "verify": "npm run test && npm run smoke"
  }
}
